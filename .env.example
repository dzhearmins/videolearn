# 复制为 .env 后填写（.env 已被 .gitignore 排除，绝不会提交）
# 学号与密码只用于换取教学网 SSO Cookie，不会写入日志
PKU_STUDENT_ID=
PKU_PASSWORD=

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
# 可选：换成任意 OpenAI 兼容端点
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：本地转写模型（tiny/base/small/medium/large-v3）
# 无 GPU 时建议 small；追求质量可改 medium（更慢）
VIDEOLRN_WHISPER_MODEL=small

# 可选：云端 ASR（OpenAI 兼容 /audio/transcriptions）
# 设成 cloud 后不再用本地 whisper；详见 docs/cloud-asr.md
# VIDEOLRN_ASR_BACKEND=cloud
# ASR_BASE_URL=https://api.siliconflow.cn/v1
# ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# ASR_API_KEY=
# ASR_LANGUAGE=zh
# ASR_TIMEOUT=180
# ASR_CHUNK_SECONDS=300
# ASR_RESPONSE_FORMAT=json
# HuggingFace 下载加速（国内网络建议开启）
HF_ENDPOINT=https://hf-mirror.com

# 可选：视觉模型（眼睛功能）。默认与 LLM_MODEL 相同；
# deepseek-flash 支持图片输入，deepseek-v4-pro 目前只支持文本
# VISION_MODEL=deepseek-flash

# 可选：单次 LLM 输入预算（token，按 1 token/字符保守估算）
# 默认 60000；若换用 8k/32k 上下文的小模型，请调低
# VIDEOLRN_MAX_INPUT_TOKENS=60000

# 可选：按课程补充术语，帮助 ASR 正确断句（不是让模型编内容）
# VIDEOLRN_ASR_PROMPT=以下是高等代数课堂录音，涉及矩阵、上三角阵、初等矩阵、Borel 子群、可逆、行列式。

# 可选：共享总结服务。同班有人跑过同一节课时，可以直接复制结果（不下载视频、不跑 ASR）。
# 在网页「设置 → 共享总结」里填地址 + 邀请码 + 昵称，注册后这三项会自动写入。
# SHARE_SERVER=http://39.97.231.204/vl
# SHARE_TOKEN=
# SHARE_NAME=同学A

# 可选：任务完成后自动删除下载的视频（默认关闭；文字稿、重述、截图都会保留）
# 也可以随时在网页「设置」里勾选，或到首页「视频存储」手动删。
VIDEOLRN_AUTO_CLEAN_VIDEO=0
